{
  "name": "ZPWR Crimson",
  "author": "MenkeTechnologies",
  "dark": true,
  "editorScheme": "/zpwr-crimson-dark.xml",
  "colors": {
    "ink": "#0a0506",
    "panel": "#140a0c",
    "card": "#1a0d10",
    "hover": "#2a1318",
    "border": "#3e1a22",
    "cyan": "#2dd4bf",
    "cyanBright": "#62dfcf",
    "pink": "#e11d48",
    "magenta": "#f43f5e",
    "green": "#22c55e",
    "orange": "#fb923c",
    "yellow": "#fbbf24",
    "text": "#ffe4e6",
    "textSoft": "#e7c9cd",
    "textDim": "#b08a92",
    "muted": "#6b4a52"
