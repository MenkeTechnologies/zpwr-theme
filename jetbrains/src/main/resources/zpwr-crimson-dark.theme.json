    "Notification": {
      "background": "card",
      "borderColor": "border",
      "errorBackground": "#ff073a22",
      "errorBorderColor": "pink"
    },
    "Tooltip": {
      "background": "card",
      "borderColor": "border"
    },
    "Counter": {
      "background": "pink",
      "foreground": "ink"
    }
  },
  "icons": {
    "ColorPalette": {
      "Actions.Blue": "#2dd4bf",
      "Actions.Green": "#22c55e",
      "Actions.Red": "#ff073a",
      "Actions.Yellow": "#fbbf24",
      "Actions.Grey": "#b08a92",
      "Objects.Blue": "#2dd4bf",
      "Objects.Green": "#22c55e",
      "Objects.Pink": "#e11d48",
      "Objects.Purple": "#f43f5e",
      "Objects.Red": "#ff073a",
      "Objects.Yellow": "#fbbf24",
      "Objects.Grey": "#b08a92"
    }
  }
