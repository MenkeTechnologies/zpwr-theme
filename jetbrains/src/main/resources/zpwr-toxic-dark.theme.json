      "Actions.Red": "#ff073a",
      "Actions.Yellow": "#f9f002",
      "Actions.Grey": "#8a9a6a",
      "Objects.Blue": "#00e5ff",
      "Objects.Green": "#39ff14",
      "Objects.Pink": "#c6ff00",
      "Objects.Purple": "#ff00aa",
      "Objects.Red": "#ff073a",
      "Objects.Yellow": "#f9f002",
      "Objects.Grey": "#8a9a6a"
